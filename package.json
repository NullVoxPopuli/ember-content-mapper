{
  "name": "ember-content-mapper",
  "version": "0.2.1",
  "description": "A TypeScript content mapper for Ember's .gts and .gjs files",
  "repository": "NullVoxPopuli/ember-content-mapper",
  "license": "MIT",
  "author": "NullVoxPopuli",
  "type": "module",
  "files": [
    "src"
  ],
  "scripts": {
    "bench": "node --expose-gc test/mapper.bench.mjs",
    "bench:compare": "node scripts/bench-compare.mjs",
    "bench:summary": "./scripts/local-bench-summary.sh",
    "bench:tsc": "node test/tsc.bench.mjs",
    "format": "oxfmt",
    "lint:format": "oxfmt --check",
    "lint:types": "tsc",
    "test": "node --test 'test/*.js'",
    "test:examples": "pnpm --filter './examples/*' lint:types && pnpm --filter nvp-library --filter ember-library-v2 build",
    "test:typecheck": "node --test test/typecheck.js test/modes.js test/lsp.js",
    "test:unit": "node --test test/fixtures.js test/initialize.js test/project.js test/server.js"
  },
  "dependencies": {
    "@glint/ember-tsc": "~1.11.0",
    "vscode-jsonrpc": "^9.0.0"
  },
  "devDependencies": {
    "@glimmer/component": "^2.1.1",
    "@glint/template": "^1.8.0",
    "@glint/type-test": "^2.0.1",
    "@tsconfig/ember": "^3.0.10",
    "@types/node": "^24.0.0",
    "@volar/language-core": "~2.4.28",
    "ember-content-mapper": "link:.",
    "ember-source": "^7.2.0",
    "expect-type": "^1.2.1",
    "mitata": "^1.0.34",
    "oxfmt": "^0.65.0",
    "release-plan": "^0.18.0",
    "snapshot-fixtures": "^1.3.3",
    "typescript": "~5.9.3",
    "typescript-7": "npm:typescript@7.1.0-dev.20260821.1",
    "vscode-languageserver-protocol": "^3.18.2"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^22.21.1 || >=24.10.0"
  },
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "src/server.js"
      ],
      "compilerOptions": [],
      "dynamicConfig": true
    }
  }
}
