{
  "name": "nvp-app",
  "version": "0.0.0",
  "private": true,
  "description": "Your Ember App's description here",
  "repository": "",
  "license": "MIT",
  "author": "",
  "type": "module",
  "imports": {
    "#app/*": "./app/*",
    "#config": "./app/config.ts",
    "#components/*": "./app/components/*",
    "#services/*": "./app/services/*",
    "#test-helpers/*": "./tests/helpers/*",
    "#utils/*": "./app/utils/*"
  },
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "start": "vite",
    "build:test": "EMBER_ENV=test NODE_ENV=development vite build --mode development",
    "test:ci": "testem ci --port 0",
    "test": "pnpm build:test && pnpm test:ci",
    "lint:types": "tsc --noEmit --runExternalCode"
  },
  "dependencies": {
    "@embroider/macros": "1.20.6",
    "@embroider/router": "3.0.6",
    "@glimmer/component": "2.1.1",
    "decorator-transforms": "2.4.0",
    "ember-modifier": "^4.3.0",
    "ember-source": "7.2.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-runtime": "7.29.7",
    "@babel/plugin-transform-typescript": "7.29.7",
    "@babel/runtime": "7.29.7",
    "@ember/app-tsconfig": "2.0.0",
    "@ember/test-helpers": "5.4.3",
    "@ember/test-waiters": "4.1.2",
    "@embroider/core": "4.6.3",
    "@glint/ember-tsc": "~1.13.1",
    "@glint/template": "1.11.0",
    "@nullvoxpopuli/ember-vite": "1.1.0",
    "@rollup/plugin-babel": "7.1.0",
    "@types/qunit": "2.19.14",
    "babel-plugin-debug-macros": "2.0.0",
    "babel-plugin-ember-template-compilation": "4.0.0",
    "ember-content-mapper": "workspace:*",
    "ember-qunit": "9.1.0",
    "qunit": "2.26.0",
    "qunit-dom": "3.5.0",
    "qunit-theme-ember": "1.0.0",
    "testem": "3.17.0",
    "typescript": "7.1.0-dev.20261029.1",
    "vite": "8.2.2"
  },
  "engines": {
    "node": ">= 24"
  },
  "ember": {
    "edition": "octane"
  }
