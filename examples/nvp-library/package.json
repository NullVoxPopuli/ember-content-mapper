{
  "name": "nvp-library",
  "private": true,
  "version": "0.0.0",
  "description": "Your Ember library's description here",
  "license": "MIT",
  "author": "",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "start": "tsdown --watch",
    "lint:types": "node ./node_modules/typescript-7/bin/tsc --noEmit --runExternalCode"
  },
  "dependencies": {
    "decorator-transforms": "2.4.0"
  },
  "peerDependencies": {
    "@glimmer/component": "^2.0.0",
    "ember-source": ">= 6.0.0"
  },
  "devDependencies": {
    "@ember/library-tsconfig": "2.0.0",
    "@glimmer/component": "2.1.1",
    "@nullvoxpopuli/ember-rolldown": "2.7.0",
    "ember-content-mapper": "workspace:*",
    "ember-source": "7.2.0",
    "tsdown": "0.22.14",
    "typescript": "6.0.3",
    "typescript-7": "npm:typescript@7.1.0-dev.20261014.1",
    "@glint/ember-tsc": "1.13.1",
    "@glint/template": "1.11.0"
  },
  "engines": {
    "node": ">= 24"
  },
  "ember": {
    "edition": "octane"
  }
}
